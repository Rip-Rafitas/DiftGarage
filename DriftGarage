<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Drift Garage</title>
    <style>
        /* Estilos Gerais */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 0;
        }

        /* Cabeçalho */
        header {
            background: linear-gradient(135deg, #ff4500, #b30000);
            padding: 40px 20px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        }

        header h1 {
            margin: 0;
            font-size: 3.5rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.6);
        }

        header p {
            margin: 10px 0 0 0;
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Contentor Principal */
        .container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }

        /* Secção da Garagem (Grelha de Carros) */
        .garage-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-top: 20px;
        }

        /* Cartão de Carro */
        .car-card {
            background-color: #1e1e1e;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid #333;
        }

        .car-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(255, 69, 0, 0.2);
            border-color: #ff4500;
        }

        /* Espaço para Imagem (Placeholder) */
        .car-image {
            width: 100%;
            height: 200px;
            background-color: #2a2a2a;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #666;
            font-weight: bold;
        }

        .car-info {
            padding: 20px;
        }

        .car-info h3 {
            margin: 0 0 10px 0;
            color: #ff4500;
            font-size: 1.5rem;
        }

        .car-info p {
            margin: 5px 0;
            color: #cccccc;
            font-size: 0.95rem;
        }

        .specs {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid #333;
            display: flex;
            justify-content: space-between;
            font-size: 0.85rem;
            color: #aaa;
        }

        /* Rodapé */
        footer {
            text-align: center;
            padding: 30px;
            margin-top: 60px;
            background-color: #0a0a0a;
            color: #555;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <header>
        <h1>Drift Garage</h1>
        <p>A minha coleção de máquinas preparadas para fazer fumo</p>
    </header>

    <div class="container">
        <h2>As Minhas Máquinas</h2>
        
        <div class="garage-grid">
            
            <!-- Carro 1 -->
            <div class="car-card">
                <div class="car-image">FOTO DO CARRO</div>
                <div class="car-info">
                    <h3>Nissan Silvia S15</h3>
                    <p>Preparação completa para competição com kit de ângulo alargado e suspensão regulável.</p>
                    <div class="specs">
                        <span><strong>Motor:</strong> SR20DET</span>
                        <span><strong>Potência:</strong> 400 cv</span>
                    </div>
                </div>
            </div>

            <!-- Carro 2 -->
            <div class="car-card">
                <div class="car-image">FOTO DO CARRO</div>
                <div class="car-info">
                    <h3>Toyota AE86</h3>
                    <p>O clássico intemporal do drift. Aligeirado ao máximo para uma condução purista e ágil.</p>
                    <div class="specs">
                        <span><strong>Motor:</strong> 4A-GE N/A</span>
                        <span><strong>Potência:</strong> 180 cv</span>
                    </div>
                </div>
            </div>

            <!-- Carro 3 -->
            <div class="car-card">
                <div class="car-image">FOTO DO CARRO</div>
                <div class="car-info">
                    <h3>BMW E36 M3</h3>
                    <p>Diferencial soldado, travão de mão hidráulico e pronto para destruir pneus na pista.</p>
                    <div class="specs">
                        <span><strong>Motor:</strong> S50B32</span>
                        <span><strong>Potência:</strong> 321 cv</span>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <footer>
        <p>&copy; 2026 Drift Garage. Criado com HTML e CSS no GitHub.</p>
    </footer>

</body>
</html>
